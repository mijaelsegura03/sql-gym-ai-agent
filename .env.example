# Configuración del agente (spec técnico §10.3).
# start.py crea .env a partir de este archivo, genera los secretos internos vacíos
# y pide las API keys la primera vez. Nunca se versiona el .env.

GOOGLE_API_KEY=
# Modelos del plan gratuito con cuota diaria alta (500 requests/día cada uno, verificado en AI Studio el
# 03/10/2026). Los "flash" no lite tienen 20 requests/día. Cada rol usa un modelo distinto para repartir la cuota.
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_MAIN=gemini-3.5-flash-lite
GEMINI_MODEL_JUEZ=gemini-3.1-flash-lite
GEMINI_THINKING_FAST=0
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5433
DB_NAME=gimnasio
DB_PASS_LECTOR_ADMIN=
DB_PASS_LECTOR_SOCIO=
DB_PASS_ESCRITOR=

CHROMA_DIR=.chroma
RAG_TOP_K=5
# Calibrado con los casos de documentos (DT-04): el mejor fragmento relevante queda entre 0,18 y 0,25 de distancia
# coseno, otros fragmentos necesarios llegan a 0,36 y los temas no cubiertos arrancan cerca de 0,27. Como no
# separan bien, se deja un umbral permisivo y sintetizar decide si los fragmentos cubren el tema (RF-11).
RAG_DISTANCIA_MAX=0.45

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gimnasio-agente

PSEUDONIMO_SECRET=
# Requests por minuto a Gemini durante la evaluación (los modelos lite permiten 15 RPM).
EVAL_RPM=12
